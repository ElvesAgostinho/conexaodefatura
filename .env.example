# =====================================================================
# Gateway Fiscal: origens (HOST e outros sistemas) -> Django -> AGT
# Copiar para .env e preencher. O .env NUNCA vai para o Git.
# =====================================================================

# --- Django ----------------------------------------------------------
DJANGO_DEBUG=True
# Obrigatória em produção. Gerar com:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Luanda
# True se o Gateway estiver atrás de um proxy HTTPS (nginx, IIS, ...)
DJANGO_BEHIND_PROXY=False

# --- Cifra de segredos guardados no painel ---------------------------
# Senhas das bases de dados de origem configuradas no painel ficam cifradas com esta chave.
# Vazio = derivada da DJANGO_SECRET_KEY. Gerar com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATENÇÃO: mudar esta chave (ou a DJANGO_SECRET_KEY, se esta estiver vazia) obriga a
# reintroduzir as senhas no painel.
GATEWAY_ENCRYPTION_KEY=

# --- Base de dados PRÓPRIA do Gateway ---------------------------------
# sqlite (só desenvolvimento) | postgresql | mssql | mysql | mariadb | oracle
GATEWAY_DB_ENGINE=sqlite
GATEWAY_DB_NAME=
GATEWAY_DB_HOST=
GATEWAY_DB_PORT=
GATEWAY_DB_USER=
GATEWAY_DB_PASSWORD=
# Só SQL Server:
GATEWAY_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
GATEWAY_DB_EXTRA_PARAMS=
# Só PostgreSQL (ex.: require):
GATEWAY_DB_SSLMODE=

# --- Base de dados do HOST (ACESSO SOMENTE LEITURA) -------------------
# mssql | postgresql | mysql | mariadb | oracle | sqlite
HOST_DB_ENGINE=mssql
HOST_DB_HOST=192.168.1.100
# Vazio = porta por omissão do motor. SQL Server com instância com nome (SRV\INST): deixar vazio.
HOST_DB_PORT=1433
# Nome da BD (Oracle: service name; SQLite: caminho do ficheiro)
HOST_DB_NAME=
# Utilizador DEDICADO com permissão apenas de SELECT.
# SQL Server: deixar vazio para usar autenticação Windows.
HOST_DB_USER=
HOST_DB_PASSWORD=
HOST_DB_CONNECT_TIMEOUT=10
# Só SQL Server:
HOST_DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# True apenas se o servidor usar certificado autoassinado (comum em redes locais).
HOST_DB_TRUST_SERVER_CERTIFICATE=False
# Parâmetros extra da ligação, formato chave=valor;chave=valor
HOST_DB_OPTIONS=
# Alternativa para outros SGBD (Firebird, DB2, Informix, ...): URL SQLAlchemy completa.
# Tem prioridade sobre os campos acima. Ex.: firebird+fdb://user:senha@host:3050/C:/dados/host.fdb
HOST_DB_URL=

# Multiempresa: outras ligações HOST com nome. A ligação X usa as mesmas variáveis com o
# prefixo HOST_X_DB_* e é associada à empresa no admin (campo "ligação HOST" = X).
# HOST_HOTEL2_DB_ENGINE=mssql
# HOST_HOTEL2_DB_HOST=SERVIDOR2\SQLEXPRESS
# HOST_HOTEL2_DB_NAME=
# HOST_HOTEL2_DB_USER=
# HOST_HOTEL2_DB_PASSWORD=

# Pasta dos relatórios de estrutura (contêm estrutura interna do HOST: não partilhar).
HOST_REPORTS_DIR=

# --- AGT ------------------------------------------------------------
# As credenciais da AGT (utilizador e senha da API, chave do contribuinte, assinatura do
# software) configuram-se no PAINEL, em Configuração AGT, e ficam cifradas na base de dados.
# Alternativa antiga, só para compatibilidade (empresa com "prefixo" = X usa AGT_X_...):
# AGT_CLIENT_SECRET=
# AGT_PRIVATE_KEY=
# AGT_PRIVATE_KEY_PASSWORD=

# --- API para sistemas externos ---------------------------------------
# Limite de pedidos por chave de API (ex.: 120/min, 5000/hour)
API_RATE_LIMIT=120/min
# Tamanho máximo de um pedido em bytes
API_MAX_BODY_BYTES=2097152

# --- Painel -----------------------------------------------------------
# Duração da sessão em segundos (omissão: 8 horas)
DJANGO_SESSION_AGE=28800
